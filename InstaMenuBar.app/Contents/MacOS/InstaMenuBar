#!/bin/bash
# InstaMenuBar launcher — runs the self-contained app with the venv Python.
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
PY="$HOME/.instawatch/venv/bin/python"
[ -x "$PY" ] || PY="$(command -v python3)"
export INSTAWATCH_PLUGIN="${INSTAWATCH_PLUGIN:-$DIR/plugins/instawatch.30m.py}"
exec "$PY" "$DIR/instaapp.py" >> "$HOME/.instawatch/instaapp.log" 2>&1
